{
    "name": "novatorius/siren-migrator",
    "autoload": {
        "psr-4": {
            "PluginNameReplaceMe\\": "src/build/",
            "PluginNameReplaceMeDependency\\": "build/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "1.0.0",
    "scripts": {
        "build": [
            "composer install",
            "vendor/bin/php-scoper add-prefix",
            "composer dump-autoload"
        ]
    },
    "require": {
        "phpnomad/core": "^1.0",
        "phpnomad/wordpress-integration": "^2.0"
    },
    "require-dev": {
        "humbug/php-scoper": "^0.18.7"
    }
}
